# Runtime
NODE_ENV=development
PORT=3000

# Database (required once persistence is implemented)
MONGODB_URI=mongodb://127.0.0.1:27017/deliveryiq2026

# Browser origin for local development; use the production URL in Vercel.
APP_ORIGIN=http://localhost:3000

# Set a long, unique value before adding authenticated sessions.
SESSION_SECRET=replace-with-a-long-random-secret

# Server-only Gemini product-category suggestions. Never expose this key to browser code.
GEMINI_API_KEY=
# Temporary server-owned scope until authenticated tenant identity is implemented.
DEFAULT_CLIENT_ID=demo-client
